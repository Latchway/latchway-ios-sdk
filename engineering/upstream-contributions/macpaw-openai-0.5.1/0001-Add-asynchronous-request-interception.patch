diff --git a/Sources/OpenAI/Private/AsyncRequestInterception.swift b/Sources/OpenAI/Private/AsyncRequestInterception.swift
new file mode 100644
index 0000000..06ccae8
--- /dev/null
+++ b/Sources/OpenAI/Private/AsyncRequestInterception.swift
@@ -0,0 +1,71 @@
+import Foundation
+
+func interceptRequest(
+    _ request: URLRequest,
+    with middlewares: [OpenAIMiddleware]
+) async throws -> URLRequest {
+    var intercepted = request
+    for middleware in middlewares {
+        try Task.checkCancellation()
+        if let asyncInterceptor = middleware as? OpenAIAsyncRequestInterceptor {
+            intercepted = try await asyncInterceptor.interceptAsync(request: intercepted)
+        } else {
+            intercepted = middleware.intercept(request: intercepted)
+        }
+    }
+    try Task.checkCancellation()
+    return intercepted
+}
+
+func usesAsyncRequestInterception(_ middlewares: [OpenAIMiddleware]) -> Bool {
+    middlewares.contains { $0 is OpenAIAsyncRequestInterceptor }
+}
+
+/// Bridges request interception with the callback and streaming APIs while
+/// preserving cancellation before and after the underlying request exists.
+final class DeferredCancellableRequest: CancellableRequest, @unchecked Sendable {
+    private let lock = NSLock()
+    private var cancelled = false
+    private var interceptionTask: Task<Void, Never>?
+    private var dispatchedRequest: CancellableRequest?
+
+    func attach(interceptionTask: Task<Void, Never>) {
+        lock.lock()
+        if cancelled {
+            lock.unlock()
+            interceptionTask.cancel()
+            return
+        }
+        self.interceptionTask = interceptionTask
+        lock.unlock()
+    }
+
+    func attach(dispatchedRequest: CancellableRequest) {
+        lock.lock()
+        interceptionTask = nil
+        if cancelled {
+            lock.unlock()
+            dispatchedRequest.cancelRequest()
+            return
+        }
+        self.dispatchedRequest = dispatchedRequest
+        lock.unlock()
+    }
+
+    func finishInterception() {
+        lock.lock()
+        interceptionTask = nil
+        lock.unlock()
+    }
+
+    func cancelRequest() {
+        lock.lock()
+        cancelled = true
+        let task = interceptionTask
+        let request = dispatchedRequest
+        lock.unlock()
+
+        task?.cancel()
+        request?.cancelRequest()
+    }
+}
