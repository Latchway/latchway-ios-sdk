diff --git a/Sources/OpenAI/Public/Protocols/OpenAIMiddleware.swift b/Sources/OpenAI/Public/Protocols/OpenAIMiddleware.swift
index 20d8d36..adc16af 100644
--- a/Sources/OpenAI/Public/Protocols/OpenAIMiddleware.swift
+++ b/Sources/OpenAI/Public/Protocols/OpenAIMiddleware.swift
@@ -14,3 +14,10 @@ public extension OpenAIMiddleware {
     func interceptStreamingData(request: URLRequest?, _ data: Data) -> Data { data }
     func intercept(response: URLResponse?, request: URLRequest, data: Data?) -> (response: URLResponse?, data: Data?) { (response, data) }
 }
+
+/// A request middleware that can refresh or sign a request asynchronously at
+/// the final request-dispatch boundary. It participates in the same ordered
+/// middleware list as ``OpenAIMiddleware``.
+public protocol OpenAIAsyncRequestInterceptor: OpenAIMiddleware {
+    func interceptAsync(request: URLRequest) async throws -> URLRequest
+}
diff --git a/Tests/OpenAITests/AsyncRequestInterceptorTests.swift b/Tests/OpenAITests/AsyncRequestInterceptorTests.swift
new file mode 100644
index 0000000..6135597
--- /dev/null
+++ b/Tests/OpenAITests/AsyncRequestInterceptorTests.swift
@@ -0,0 +1,216 @@
+import Foundation
+import Testing
+@testable import OpenAI
+
+struct AsyncRequestInterceptorTests {
+    private let configuration = OpenAI.Configuration(token: "")
+    private let originalURL = URL(string: "https://example.test/original")!
+    private let interceptedURL = URL(string: "https://example.test/intercepted")!
+
+    @Test func asyncAndSynchronousMiddlewarePreserveDeclaredOrdering() async throws {
+        let order = InterceptionOrder()
+        let first = RecordingSyncMiddleware(name: "sync-before", order: order)
+        let async = RecordingAsyncInterceptor(
+            name: "async",
+            order: order,
+            replacementURL: interceptedURL
+        )
+        let last = RecordingSyncMiddleware(name: "sync-after", order: order)
+
+        let request = try await interceptRequest(
+            URLRequest(url: originalURL),
+            with: [first, async, last]
+        )
+
+        #expect(request.url == interceptedURL)
+        #expect(order.values == ["sync-before", "async", "sync-after"])
+    }
+
+    @Test func ordinaryCallbackRequestAwaitsAsyncInterceptorAtDispatchBoundary() async throws {
+        let session = URLSessionMock()
+        session.dataTask = try DataTaskMock.successfulJson(with: ChatResult.mock)
+        let interceptor = RecordingAsyncInterceptor(
+            name: "authorize",
+            order: InterceptionOrder(),
+            replacementURL: interceptedURL
+        )
+        let client = Client(
+            configuration: configuration,
+            session: session,
+            middlewares: [interceptor],
+            dataTaskFactory: DataTaskFactory(
+                session: session,
+                responseHandler: .init(middlewares: [], configuration: configuration)
+            ),
+            cancellablesFactory: MockCancellablesFactory()
+        )
+
+        let _: Result<ChatResult, Error> = await withCheckedContinuation { continuation in
+            _ = client.performRequest(
+                request: JSONRequest<ChatResult>(url: originalURL),
+                completion: { continuation.resume(returning: $0) }
+            )
+        }
+
+        #expect(session.dataTaskWithCompletionCalls.count == 1)
