+private final class InterceptionOrder: @unchecked Sendable {
+    private let lock = NSLock()
+    private var storage: [String] = []
+
+    var values: [String] {
+        lock.lock()
+        defer { lock.unlock() }
+        return storage
+    }
+
+    func append(_ value: String) {
+        lock.lock()
+        storage.append(value)
+        lock.unlock()
+    }
+}
+
+private struct RecordingSyncMiddleware: OpenAIMiddleware {
+    let name: String
+    let order: InterceptionOrder
+
+    func intercept(request: URLRequest) -> URLRequest {
+        order.append(name)
+        return request
+    }
+}
+
+private struct RecordingAsyncInterceptor: OpenAIAsyncRequestInterceptor {
+    let name: String
+    let order: InterceptionOrder
+    let replacementURL: URL
+
+    func interceptAsync(request: URLRequest) async throws -> URLRequest {
+        await Task.yield()
+        order.append(name)
+        var request = request
+        request.url = replacementURL
+        return request
+    }
+}
+
+private struct SuspendingAsyncInterceptor: OpenAIAsyncRequestInterceptor {
+    func interceptAsync(request: URLRequest) async throws -> URLRequest {
+        try await Task.sleep(nanoseconds: 60_000_000_000)
+        return request
+    }
+}
+
+private func waitUntil(
+    timeout: Duration = .seconds(1),
+    condition: @escaping () -> Bool
+) async throws {
+    let clock = ContinuousClock()
+    let deadline = clock.now.advanced(by: timeout)
+    while !condition() {
+        guard clock.now < deadline else {
+            throw AsyncInterceptionTestError.timedOut
+        }
+        await Task.yield()
+    }
+}
+
+private enum AsyncInterceptionTestError: Error {
+    case timedOut
+}
